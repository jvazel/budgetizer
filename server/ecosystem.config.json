{
  "apps": [
    {
      "name": "budgetizer-api",
      "script": "./index.js",
      "instances": "max",
      "exec_mode": "cluster",
      "env": {
        "NODE_ENV": "production",
        "RUN_SCHEDULED_JOBS": "false"
      }
    },
    {
      "name": "budgetizer-worker",
      "script": "./index.js",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "RUN_SCHEDULED_JOBS": "true",
        "PORT": "5001"
      }
    }
  ]
}
